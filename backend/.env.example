# .env.example - Backend Configuration

# Ollama Configuration (optional - system auto-detects)
LLM_MODEL=llama3
OLLAMA_HOST=http://localhost:11434

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO

# Data Processing
MAX_DATASET_SIZE=10000
MISSING_VALUE_THRESHOLD=0.5

# Clustering
MIN_K=3
MAX_K=6
SILHOUETTE_THRESHOLD=0.45
